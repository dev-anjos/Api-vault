

<h1>{{productDto.title}}</h1>
<p>Preço: {{productDto.price}}</p>
<p>Descrição: {{productDto.description}}</p>
<form action="/api/carts/add-product" method="post">
    <input type="hidden" name="pid" value="{{productDto.id}}">
    <label>Quantidade: </label>
    <input type="number" name="quantity" min="1" value="1" required>
    <button type="submit">Adicionar ao Carrinho</button>
</form>
<a href="/products">Voltar para Produtos</a>
