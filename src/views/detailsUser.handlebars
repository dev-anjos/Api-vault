<div class=" container">
    <a href="/products" class=" btn btn-primary"> Produtos</a>
    <a href="/delete-user/{{payload.id}}" class=" btn btn-red"> Deletar Usuário</a>
</div>

<div class="text-center container-form">
    <form class="form-signin" >
        <h1 class="h3 mb-3 font-weight-normal">Perfil</h1>
        <img src="https://picsum.photos/200" class="rounded-circle" alt="Avatar" width="100" height="100">
        <label for="firstName" class="sr-only">Nome</label>
        <input type="text" name="firstName" id="firstName" class="form-control mt-2" placeholder="Nome" value="{{payload.firstName}}" readonly>
        <label for="lastName" class="sr-only">Sobrenome</label>
        <input type="text" name="lastName" id="lastName" class="form-control mt-2" placeholder="Sobrenome" value="{{payload.lastName}}" readonly>
        <label for="email" class="sr-only">Endereço de email</label>
        <input type="email" name="email" id="email" class="form-control mt-2" placeholder="Endereço de email" value="{{payload.email}}" readonly>
        <label for="birthday" class="sr-only">Data de nascimento:</label>
        <input type="date" name="birthday" id="birthday" class="form-control mt-2" placeholder="Data de nascimento" value="{{moment payload.birthday 'YYYY-MM-DD'}}" readonly>
    </form>
</div>
